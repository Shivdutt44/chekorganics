rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is permanent Super Admin
    function isSuperAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'shivduttchauhan2@gmail.com';
    }

    // Helper: Check if user is Super Admin OR an active Staff member
    function isStaffOrAdmin() {
      return isSuperAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/staff/$(request.auth.token.email.lower())).data.active == true
      );
    }

    // Helper for general admin and management privileges
    function isAdmin() {
      return isStaffOrAdmin();
    }

    // 0. STAFF & ACCESS CONTROL:
    // - Only Super Admin can view all, add, update, or revoke staff members
    // - Authenticated users can check their own staff access document
    match /staff/{staffEmail} {
      allow read: if isSuperAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == staffEmail.lower()
      );
      allow write: if isSuperAdmin();
    }

    // 1. ORDERS:
    // - Anyone can create an order (guest checkout), but cannot pre-set the delivery
    //   status, mark it paid, or attach it to someone else's account
    // - Orders hold names, phones and addresses, so reads are limited to the admin and
    //   the signed-in customer who placed them (public read let anyone download every
    //   customer's address with the site's public API key)
    // - ONLY Super Admin can update status (batching, dispatched, delivered) or delete
    match /orders/{orderId} {
      // Shoppers create orders as "pending" (UPI, matched by UTR) or "cod" (cash on delivery).
      // COD needs a signed-in customer with a verified email (free Firebase verification link),
      // which stops anonymous fake COD orders; the admin can still confirm on WhatsApp.
      // Only the admin can move an order to paid / COD-confirmed.
      allow create: if request.resource.data.keys().hasAll(['orderId', 'customer', 'address', 'items', 'payment'])
                    && !('deliveryStatus' in request.resource.data)
                    && request.resource.data.payment.method in ['upi', 'cod']
                    && request.resource.data.payment.get('status', 'pending') in ['pending', 'cod']
                    && (request.resource.data.payment.method == 'upi'
                        || (request.auth != null && request.auth.token.email_verified == true))
                    && (request.resource.data.userId == null
                        || (request.auth != null && request.resource.data.userId == request.auth.uid));
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid)
                  || (request.auth != null && request.auth.token.email != null
                      && resource.data.userEmail == request.auth.token.email.lower());
      allow update, delete: if isAdmin();
    }

    // 2. CUSTOMER REVIEWS:
    // - Public can read reviews and submit new reviews (shown on product pages), within
    //   sane limits and never self-labelled as a verified purchase
    // - ONLY Super Admin can edit or delete reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.productHandle is string
                    && request.resource.data.productHandle.size() <= 200
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.get('author', '') is string
                    && request.resource.data.get('author', '').size() <= 60
                    && request.resource.data.get('title', '') is string
                    && request.resource.data.get('title', '').size() <= 120
                    && request.resource.data.get('body', '') is string
                    && request.resource.data.get('body', '').size() <= 1000
                    && request.resource.data.get('verified', false) == false;
      allow update, delete: if isAdmin();
    }

    // 3. NEWSLETTER SUBSCRIBERS:
    // - Public can subscribe (create)
    // - ONLY Super Admin can view the subscriber email list or delete
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 4. PRODUCTS (edits made in the admin portal, layered over the store catalog):
    // - Everyone reads them (the storefront applies them)
    // - ONLY Super Admin can add, edit or delete
    match /products/{handle} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. USER PROFILES:
    // - User can manage their own profile, or Super Admin can access
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // (No admin_security collection: admin password resets use Firebase's own reset email,
    //  and a world-readable/writable OTP store let anyone read or forge reset codes.
    //  Anything not matched above is denied by default.)
  }
}
